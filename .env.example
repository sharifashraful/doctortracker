# Leave unset to start the built-in portable MongoDB. Set this only for an external database.
# MONGODB_URI=mongodb://127.0.0.1:27017/doctortracker
AUTH_SECRET=replace-with-a-random-string-at-least-32-characters-long
ADMIN_NAME=Avery Cole
ADMIN_EMAIL=admin@doctortracker.local
ADMIN_PASSWORD=ChangeMe123!
# Shows the reviewer account on the login screen. Set to false in production.
SHOW_DEMO_LOGIN=true
PORT=4000
# IANA timezone for "added on" filters and the intake chart. Defaults to the server timezone.
# CLINIC_TIMEZONE=Asia/Dhaka
# Set to 1 only when a reverse proxy sits in front of the API.
# TRUST_PROXY=1
CLIENT_ORIGIN=http://127.0.0.1:3000,http://localhost:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
